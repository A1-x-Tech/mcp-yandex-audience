{
  "name": "mcp-yandex-audience",
  "version": "1.1.1",
  "description": "MCP server for the Yandex Audience API — audience segments (CRM uploads, lookalike, pixel-based), tracking pixels and access grants for AI agents.",
  "mcpName": "io.github.A1-x-Tech/mcp-yandex-audience",
  "type": "module",
  "bin": {
    "mcp-yandex-audience": "dist/index.js"
  },
  "files": [
    "assets",
    "dist",
    "test"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "smoke": "node --import tsx src/smoke.ts",
    "test": "npm run test:src && npm run test:dist",
    "test:src": "node --import tsx --test $(find src -name '*.test.ts')",
    "test:dist": "npm run build && node --test test/dist-smoke.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "yandex",
    "yandex-audience",
    "audience",
    "segments",
    "lookalike",
    "retargeting",
    "advertising"
  ],
  "license": "MIT",
  "author": "gistrec <gistrec@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A1-x-Tech/mcp-yandex-audience.git"
  },
  "homepage": "https://github.com/A1-x-Tech/mcp-yandex-audience#readme",
  "bugs": {
    "url": "https://github.com/A1-x-Tech/mcp-yandex-audience/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
